# Copy to `.env.local` for local development. Never commit `.env.local`.
# See docs/environment.md for narrative setup notes.

# Canonical site URL (metadata, sitemap, emails, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://chezamisrestaurant.com

# Public brand strings (footer, emails, templates)
NEXT_PUBLIC_RESTAURANT_NAME=Chez Amis Bar and Grill
NEXT_PUBLIC_PHONE=+2330557032312
NEXT_PUBLIC_EMAIL=chez@chezamisrestaurant.com
NEXT_PUBLIC_RESTAURANT_ADDRESS=40 Boundary Rd, East Legon, Accra, Ghana

# Admin dashboard login (password required — no default in code)
ADMIN_USERNAME=chezamis_admin
ADMIN_PASSWORD=

# Internal alerts (contact form forwards, newsletter, events)
ADMIN_EMAIL=chez@chezamisrestaurant.com
ADMIN_PHONE=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chez Amis <noreply@chezamisrestaurant.com>

# Twilio (SMS; optional if not configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Order persistence backend selector: file | kv | mongodb | supabase
# IMPORTANT: production should use `supabase` to avoid multi-instance data drift.
ORDER_STORAGE_BACKEND=file

# Supabase (required when ORDER_STORAGE_BACKEND=supabase or when using Supabase features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Checkout: pay on delivery / at pickup only (no card or mobile-money online yet).
# Omit or set to true. Set to false when payment gateway integration is live.
NEXT_PUBLIC_PAYMENT_ON_DELIVERY_ONLY=true

# Optional: used for admin notification fallback and outbox retry records
ADMIN_EMAIL=chez@chezamisrestaurant.com
ADMIN_PHONE=+233557032312

# Outbox retry worker
OUTBOX_CRON_SECRET=
OUTBOX_MAX_RETRIES=6

# Distributed API rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev-only: /api/test-notifications targets
TEST_EMAIL=test@example.com
TEST_PHONE=+233024395239
